{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poke the Colleague",
  "mainBinaryName": "poke-the-colleague",
  "version": "0.3.0",
  "identifier": "dev.poke.colleague",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Poke the Colleague",
        "url": "index.html",
        "width": 400,
        "height": 660,
        "minWidth": 340,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "shortDescription": "Full-screen alerts when a colleague calls you",
    "longDescription": "Poke the Colleague shows a full-screen alert and plays a ring through your headphones when a teammate pokes you, so you never miss someone calling your name.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBNUJDQzI1MkQ0ODU1MTYKUldRV1ZVZ3RKY3hiNnZsSlJPOWRtTlM5OXU1eHZrdHd5Q3ExSEwvMi94ZHcyTGVIMUJxV0wxdDQK",
      "endpoints": [
        "https://github.com/theNAFIZ/poke-the-colleague/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
