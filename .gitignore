# ---- Rust ----
# Build output (also holds the .exe/.deb/.AppImage bundles). Cargo.lock IS committed.
/target/

# ---- Node (app CLI tooling, relay) ----
# package-lock.json files ARE committed (`npm ci` needs them).
node_modules/

# ---- Tauri ----
# Regenerated on every build (ACL manifests + JSON schemas).
/app/src-tauri/gen/schemas/

# ---- Cloudflare relay ----
# Local Durable Object state from `wrangler dev`.
.wrangler/
# Generated by `wrangler types` (large; CI and `npm run typecheck` regenerate it).
/relay/worker-configuration.d.ts

# ---- Secrets: never commit ----
.dev.vars
.dev.vars.*
.env
.env.*
*.pfx
*.p12
*.pem
*.key

# ---- Logs / editors / OS ----
*.log
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Claude Code local state ----
.claude/scheduled_tasks.lock
